{
  "hosting": {
    "public": "web",
    "ignore": ["firebase.json", "**/node_modules/**"],
    "rewrites": [
      { "source": "/v/**", "function": { "functionId": "share", "region": "us-central1" } },
      { "source": "/u/**", "function": { "functionId": "share", "region": "us-central1" } },
      { "source": "/sitemap.xml", "function": { "functionId": "sitemap", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/.well-known/assetlinks.json", "headers": [{ "key": "Content-Type", "value": "application/json" }] },
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ] }
    ]
  },
  "functions": [{ "source": "functions", "codebase": "default", "runtime": "nodejs22" }],
  "firestore": { "rules": "firebase/firestore.rules" },
  "storage": { "rules": "firebase/storage.rules" }
}
