rules_version = '2';

// Twirlly security rules. Everything is closed unless a rule below opens it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // Email accounts must have confirmed their email. Google accounts are confirmed by Google.
    function confirmed() {
      return signedIn() && (request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    function isOwner(uid) {
      return confirmed() && request.auth.uid == uid;
    }

    function validProfile(d) {
      return d.keys().hasOnly(['username', 'displayName', 'bio', 'isPrivate', 'verified', 'createdAt',
                               'updatedAt', 'nameChangedAt', 'usernameChangedAt', 'avatarUrl', 'bannerUrl'])
          && d.username is string && d.username.matches('^[a-z0-9_.]{3,24}$')
          && d.displayName is string && d.displayName.size() <= 40
          && d.bio is string && d.bio.size() <= 200
          && d.isPrivate is bool;
    }

    // A name or username can change once every 7 days, and the time is set by the server clock.
    function nameOk() {
      return request.resource.data.displayName == resource.data.displayName
          || (( !('nameChangedAt' in resource.data) || request.time > resource.data.nameChangedAt + duration.value(7, 'd'))
              && request.resource.data.nameChangedAt == request.time);
    }
    function usernameOk() {
      return request.resource.data.username == resource.data.username
          || (( !('usernameChangedAt' in resource.data) || request.time > resource.data.usernameChangedAt + duration.value(7, 'd'))
              && request.resource.data.usernameChangedAt == request.time);
    }

    match /users/{uid} {
      // other signed-in people may see the public profile (name, username, bio, badge)
      allow read: if confirmed();
      // a new profile can never start verified: only the server (admin) can give the badge
      allow create: if isOwner(uid) && validProfile(request.resource.data) && request.resource.data.verified == false
          && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validProfile(request.resource.data)
          && request.resource.data.verified == resource.data.verified
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && nameOk() && usernameOk();
      allow delete: if isOwner(uid);

      // your private copy of your data (posts, drafts, settings, kids mode, ...): only you
      match /state/{doc} {
        allow read, write: if isOwner(uid);
      }
      // coins and Premium: only the server (Cloud Functions) can change them
      match /wallet/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /private/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

    // a username belongs to one person
    match /usernames/{name} {
      allow read: if confirmed();
      allow create: if confirmed() && name.matches('^[a-z0-9_.]{3,24}$')
          && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if confirmed() && resource.data.uid == request.auth.uid;
    }

    // ---------- shared posts ----------
    function likePath(postId) {
      return /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /posts/{postId} {
      allow read: if confirmed();
      allow create: if confirmed() && request.resource.data.uid == request.auth.uid
          && request.resource.data.likesCount == 0 && request.resource.data.commentsCount == 0
          && request.resource.data.caption is string && request.resource.data.caption.size() <= 600
          && request.resource.data.project is string && request.resource.data.project.size() < 200000;
      allow update: if confirmed() && (
          (resource.data.uid == request.auth.uid && onlyChanges(['caption']))
          || (onlyChanges(['likesCount']) && (
                (!exists(likePath(postId)) && existsAfter(likePath(postId)) && request.resource.data.likesCount == resource.data.likesCount + 1)
             || (exists(likePath(postId)) && !existsAfter(likePath(postId)) && request.resource.data.likesCount == resource.data.likesCount - 1)))
          || (onlyChanges(['commentsCount']) && (request.resource.data.commentsCount == resource.data.commentsCount + 1
                || request.resource.data.commentsCount == resource.data.commentsCount - 1)));
      allow delete: if confirmed() && resource.data.uid == request.auth.uid;

      match /likes/{uid} {
        allow read: if confirmed();
        allow create, delete: if confirmed() && request.auth.uid == uid;
      }
      match /comments/{cid} {
        allow read: if confirmed();
        allow create: if confirmed() && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string && request.resource.data.text.size() <= 3000
            && (request.resource.data.text.size() > 0 || request.resource.data.get('media', '') != '')
            && (request.resource.data.get('media', '') == '' || request.resource.data.media.matches('^(https://.{1,480}|anim:.{1,16})$'));
        allow delete: if confirmed() && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid);
      }
    }

    match /follows/{id} {
      allow read: if confirmed();
      allow create: if confirmed() && request.resource.data.follower == request.auth.uid
          && request.resource.data.follower != request.resource.data.following
          && id == request.auth.uid + '_' + request.resource.data.following;
      allow delete: if confirmed() && resource.data.follower == request.auth.uid;
    }

    // reports are write-only for people; your moderation tools read them with admin access
    match /reports/{id} {
      allow create: if confirmed() && request.resource.data.reporter == request.auth.uid;
    }
  }
}

